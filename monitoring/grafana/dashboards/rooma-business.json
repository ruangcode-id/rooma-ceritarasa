          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n  WHEN COUNT(*) FILTER (WHERE status IN ('confirmed', 'checked_in', 'no_show')) = 0 THEN 0\n  ELSE ROUND(\n    100.0 * COUNT(*) FILTER (WHERE status = 'no_show')\n    / COUNT(*) FILTER (WHERE status IN ('confirmed', 'checked_in', 'no_show')),\n    1\n  )\nEND::float8 AS value\nFROM reservations\nWHERE date >= CURRENT_DATE - INTERVAL '30 days'\n  AND date < CURRENT_DATE;",
          "refId": "A"
        }
      ],
      "title": "Rasio no-show 30 hari (%)",
