# Production reverse proxy for Rooma Ceritarasa
#
# SITE_ADDRESS examples (.env.production):
#   - Domain (HTTPS): roomaceritarasa.com
#   - HTTP only: :80
# Jangan tulis https:// dan jangan :roomaceritarasa.com
#
# GRAFANA_ADDRESS example:
#   grafana.roomaceritarasa.com

{
	email {$ACME_EMAIL:admin@localhost}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	header {
		# Defense-in-depth (app juga set security headers di next.config.ts)
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}

{$GRAFANA_ADDRESS} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy grafana:3000

	log {
		output stdout
		format console
	}
}
