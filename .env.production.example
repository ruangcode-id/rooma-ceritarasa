# ============================================================
# Rooma Ceritarasa — Production env template (VPS)
# ============================================================
# Salin ke VPS sebagai `.env.production` (JANGAN commit file berisi secret):
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Generate secrets:
#   openssl rand -base64 32   # AUTH_SECRET / CRON_SECRET / POSTGRES_PASSWORD

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---- Postgres (Docker service name = db) ----
POSTGRES_USER=rooma_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=rooma_db
# DATABASE_URL dibangun otomatis di scripts/docker-entrypoint.sh (password URL-encoded, host=db).
# Jangan set DATABASE_URL manual kecuali Anda paham encoding-nya.

# ---- Public URL / Auth.js ----
# Sebelum domain ada: pakai http://IP_VPS (tanpa HTTPS otomatis)
# Setelah domain: https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
AUTH_URL=https://your-production-domain.com
AUTH_TRUST_HOST=true
AUTH_SECRET=replace-with-a-strong-random-secret

# ---- Caddy ----
# Domain + HTTPS: roomaceritarasa.com
# Staging HTTP saja: :80
# Jangan pakai https:// dan jangan :roomaceritarasa.com
SITE_ADDRESS=roomaceritarasa.com
ACME_EMAIL=admin@your-production-domain.com
GRAFANA_ADDRESS=grafana.roomaceritarasa.com

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# IP/CIDR yang boleh buka grafana subdomain (spasi-pisah, WAJIB pakai tanda kutip jika >1 IP).
# Cek IP publik laptop: curl -4 ifconfig.me
GRAFANA_ALLOWED_IPS="203.0.113.10"
# User Postgres read-only (buat via: sudo bash scripts/create-grafana-readonly-user.sh)
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=CHANGE_ME_GRAFANA_DB_PASSWORD

# ---- Cron (panggil dari crontab VPS, bukan vercel.json) ----
CRON_SECRET=replace-with-a-strong-random-secret

# ---- Rate limit reservasi publik (per IP / jam) ----
# Default kode = 3. Untuk staging/testing bisa naikkan, mis. 30.
PUBLIC_RESERVATION_RATE_LIMIT_PER_HOUR=30

# ---- Midtrans ----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend (email) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CAREER_ADMIN_EMAIL=

# ---- Fonnte (WhatsApp) ----
FONNTE_TOKEN=
FONNTE_SENDER=

# ---- Web Push (opsional) ----
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-production-domain.com
